# Copy to .env — the name must be exactly ".env", next to docker-compose.yml.

# Which model: hunyuan (default) or trellis2. Then `docker compose pull` once.
ENGINE=hunyuan

# Only `serve` needs these three.
SITE_URL=https://your-site.example
WORKER_SECRET=paste-the-same-secret-the-site-has
WORKER_NAME=pc-1

# Optional, for every command: reuse Hunyuan3D-2.1 weights you already have.
# The folder that contains hunyuan3d-dit-v2-1/ (config.yaml + model.fp16.ckpt).
# HUNYUAN_DIR=D:/AI/Hunyuan3D-2.1

# Optional: use ComfyUI's single-file model instead (Comfy-Org's
# hunyuan_3d_v2.1.safetensors). The folder that contains the file:
# COMFYUI_CHECKPOINTS=C:/AI/ComfyUI/models/checkpoints
# Only if your file has a different name:
# HUNYUAN_CHECKPOINT=hunyuan_3d_v2.1.safetensors

# --- TRELLIS.2 (ENGINE=trellis2) ---
# Folder for its weights (~9 GB, downloaded on first start if missing).
# TRELLIS_DIR=D:/AI/trellis2
# It needs Meta's DINOv3 image encoder, which is gated: request access at
# https://huggingface.co/facebook/dinov3-vitl16-pretrain-lvd1689m , create a
# read token at https://huggingface.co/settings/tokens , and paste it here.
# HF_TOKEN=hf_...
